{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Agent Registry Prototype",
  "type": "object",
  "required": ["version", "updatedAt", "network", "purpose", "agents"],
  "properties": {
    "version": {"type": "string"},
    "updatedAt": {"type": "string"},
    "network": {"type": "string"},
    "purpose": {"type": "string"},
    "sources": {"type": "array"},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "status", "description", "capabilities", "trust"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "status": {"type": "string"},
          "description": {"type": "string"},
          "operator": {"type": "string"},
          "publicHandles": {"type": "object"},
          "wallets": {"type": "object"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "paymentRails": {"type": "array"},
          "trust": {"type": "object"},
          "approvalBoundaries": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
